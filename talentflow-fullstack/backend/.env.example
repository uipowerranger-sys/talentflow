APP_NAME=TalentFlow API
ENVIRONMENT=development
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://talentflow:talentflow@localhost:5432/talentflow
JWT_SECRET_KEY=replace-with-a-random-32-byte-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
RESUME_STORAGE_DIR=./var/resumes
AZURE_STORAGE_CONNECTION_STRING=
AZURE_RESUME_CONTAINER=resumes
MAX_RESUME_SIZE_BYTES=10485760
REDIS_URL=redis://localhost:6379/0
MATCH_WEIGHT_REQUIRED_SKILLS=0.40
MATCH_WEIGHT_EXPERIENCE=0.25
MATCH_WEIGHT_TECHNICAL_STACK=0.20
MATCH_WEIGHT_DOMAIN_ROLE=0.10
MATCH_WEIGHT_EDUCATION=0.05
